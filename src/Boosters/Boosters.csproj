<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RRSOS.PCC.Boosters</AssemblyName>
    <RootNamespace>RRSOS.PCC.Boosters</RootNamespace>
    <Description>Boosters: a Boosters screen that builds machines with their optimizers at a beacon</Description>
    <Version>0.1.0</Version>
    <ModFolder>RRSOS-PCC-Boosters</ModFolder>
  </PropertyGroup>

  <Import Project="..\Mod.props" />

  <ItemGroup>
    <Compile Include="..\Shared\ModLog.cs" Link="Shared\ModLog.cs" />
    <Compile Include="..\Shared\Placement.cs" Link="Shared\Placement.cs" />
    <Compile Include="..\Shared\GroupCloner.cs" Link="Shared\GroupCloner.cs" />
    <Compile Include="..\Shared\CustomIcons.cs" Link="Shared\CustomIcons.cs" />
    <Compile Include="..\Shared\WorldState.cs" Link="Shared\WorldState.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The screen is Unity UI with TextMeshPro text. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManaged)Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
