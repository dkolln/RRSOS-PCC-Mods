<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RRSOS.PCC.Resupply</AssemblyName>
    <RootNamespace>RRSOS.PCC.Resupply</RootNamespace>
    <Description>A resupply icon on a storage container's window that refills it with the item its label or category names, and a Supply Manager screen for the drone network</Description>
    <Version>0.2.0</Version>
    <ModFolder>RRSOS-PCC-Resupply</ModFolder>
  </PropertyGroup>

  <Import Project="..\Mod.props" />

  <ItemGroup>
    <Compile Include="..\Shared\ModLog.cs" Link="Shared\ModLog.cs" />
    <Compile Include="..\Shared\WorldState.cs" Link="Shared\WorldState.cs" />
    <Compile Include="..\Shared\ChatHook.cs" Link="Shared\ChatHook.cs" />
    <Compile Include="..\Shared\ItemLookup.cs" Link="Shared\ItemLookup.cs" />
    <Compile Include="..\Shared\CrateFill.cs" Link="Shared\CrateFill.cs" />
    <!-- Messages go to the terminal when that mod is installed (it is optional). -->
    <Compile Include="..\Shared\TerminalRegistration.cs" Link="Shared\TerminalRegistration.cs" />
    <Compile Include="..\Shared\GroupCloner.cs" Link="Shared\GroupCloner.cs" />
    <Compile Include="..\Shared\CustomIcons.cs" Link="Shared\CustomIcons.cs" />
    <!-- The built-in extra names for items, read at start-up. -->
    <EmbeddedResource Include="..\Shared\DefaultNames.txt" LogicalName="DefaultNames.txt" />
    <!-- The Supply Manager screen's pictures: the build menu icon, and the face of a placed screen. -->
    <EmbeddedResource Include="Assets\SupplyManager.png" LogicalName="SupplyManager.png" />
    <EmbeddedResource Include="Assets\SupplyFace.png" LogicalName="SupplyFace.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon and the Supply Manager screen are Unity UI objects with TextMeshPro text. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManaged)Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
