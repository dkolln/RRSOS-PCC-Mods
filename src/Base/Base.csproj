<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RRSOS.PCC.Base</AssemblyName>
    <RootNamespace>RRSOS.PCC.Base</RootNamespace>
    <Description>Builds the T0 base in the running game, with /build and /undo</Description>
    <Version>0.4.0</Version>
    <ModFolder>RRSOS-PCC-Base</ModFolder>
  </PropertyGroup>

  <Import Project="..\Mod.props" />

  <ItemGroup>
    <Compile Include="..\Shared\ModLog.cs" Link="Shared\ModLog.cs" />
    <Compile Include="..\Shared\WorldState.cs" Link="Shared\WorldState.cs" />
    <Compile Include="..\Shared\Placement.cs" Link="Shared\Placement.cs" />
    <Compile Include="..\Shared\ChatHook.cs" Link="Shared\ChatHook.cs" />
    <Compile Include="..\Shared\Boot.cs" Link="Shared\Boot.cs" />
    <Compile Include="..\Shared\TerminalRegistration.cs" Link="Shared\TerminalRegistration.cs" />
    <Compile Include="..\Shared\Welcome.cs" Link="Shared\Welcome.cs" />
    <!-- Crates are stocked from their labels, as Auto Fill does. -->
    <Compile Include="..\Shared\ItemLookup.cs" Link="Shared\ItemLookup.cs" />
    <Compile Include="..\Shared\CrateFill.cs" Link="Shared\CrateFill.cs" />
    <EmbeddedResource Include="..\Shared\DefaultNames.txt" LogicalName="DefaultNames.txt" />
    <!-- The T0 base, captured from a save by tools\capture-t0.py. -->
    <EmbeddedResource Include="T0.json" LogicalName="T0.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Energy window's buttons are Unity UI objects with TextMeshPro text. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManaged)Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(GameManaged)UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
