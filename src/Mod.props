<Project>

  <!-- What every mod project shares. A mod's csproj sets AssemblyName, RootNamespace, Description, Version and ModFolder, then imports this. -->
  <PropertyGroup>
    <!-- The game runs Unity 6 on Mono, so plugins target netstandard2.1. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
  </ItemGroup>

  <!-- The game's own assemblies. Referenced in place and never copied or committed. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The player and manager classes derive from the game's networking types. -->
    <Reference Include="Unity.Netcode.Runtime">
      <HintPath>$(GameManaged)Unity.Netcode.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Each mod describes itself in a mod.json next to its project; it travels with the DLL. -->
  <ItemGroup>
    <None Include="mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- After a build, drop the mod into the game's BepInEx\plugins\<ModFolder>, but only once BepInEx is installed there. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(PluginsFolder)')">
    <Copy SourceFiles="$(TargetPath);$(ProjectDir)mod.json" DestinationFolder="$(PluginsFolder)$(ModFolder)\" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(PluginsFolder)$(ModFolder)\" />
  </Target>

</Project>
